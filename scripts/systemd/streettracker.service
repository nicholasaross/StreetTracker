; StreetTracker live runtime — Orin Nano 8GB Super.
;
; Install (after `scripts/setup_orin.sh` has run and a TRT engine has
; been built on the device):
;
;   sudo cp scripts/systemd/streettracker.service /etc/systemd/system/
;   sudo systemctl daemon-reload
;   sudo systemctl enable --now streettracker.service
;   journalctl -u streettracker -f
;
; If your install path or user differ from the defaults below, edit the
; copied file in /etc/systemd/system/ rather than the repo copy.
;
; The defaults assume:
;   - repo cloned at /home/streettracker/streettracker
;   - service user `streettracker` (matches scripts/pull_session defaults)
;   - camera config at $WORKDIR/configs/camera.json
;   - uv installed at ~/.local/bin/uv (setup_orin.sh does this)

[Unit]
Description=StreetTracker live RTSP tracker (Orin)
Documentation=https://github.com/nicholasaross/StreetTracker
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=streettracker
Group=streettracker
WorkingDirectory=/home/streettracker/streettracker

; uv handles the venv; PATH must include ~/.local/bin (where uv lives)
; and /usr/local/cuda/bin (for libnvinfer at runtime).
Environment=PATH=/home/streettracker/.local/bin:/usr/local/cuda/bin:/usr/bin:/bin
Environment=HOME=/home/streettracker

; Reolink RTSP requires the FFmpeg backend in TCP mode — both NanoTracker
; and StreetTracker confirmed GStreamer-backed cv2 stalls on Reolink
; keyframes. See CLAUDE.md "Device runtime notes".
Environment=OPENCV_FFMPEG_CAPTURE_OPTIONS=rtsp_transport;tcp

; The community Jetson torch wheel (cp310, sm_87) is linked against
; system cuDNN + cuBLAS and the venv-bundled libcudss. Without this
; the runtime fails immediately at `import torch` on a fresh JetPack
; 6.x box. The same export lives in ~/.bashrc for interactive use.
Environment=LD_LIBRARY_PATH=/usr/local/cuda-12.6/lib64:/usr/lib/aarch64-linux-gnu:/home/streettracker/streettracker/.venv/lib/python3.10/site-packages/nvidia/cu12/lib

; --no-sync: the venv on the Orin includes the jetson-ai-lab torch wheel
; plus tensorrt symlinks from the system. A default `uv run` would
; resync against pyproject.toml, which on aarch64 should already pick
; the right index — but if the resolver ever flapped (e.g., a wheel
; got pulled from jetson-ai-lab), an auto-sync would clobber the
; running install. Pinning to --no-sync makes the service immune to
; that class of failure; deploy refreshes happen via an explicit
; `git pull && uv sync` during a maintenance window.
ExecStart=/home/streettracker/.local/bin/uv run --no-sync streettracker run \
    --config configs/camera.json

; Crash recovery: restart on any unclean exit, but back off so a broken
; engine file doesn't burn CPU in a tight loop.
Restart=on-failure
RestartSec=10s

; Logging: journald owns stdout/stderr; structured session JSON is still
; written to output/ on disk.
StandardOutput=journal
StandardError=journal
SyslogIdentifier=streettracker

; The runtime writes session crops + JSON under ./output; make sure that
; directory is writable by the service user before enabling.
ReadWritePaths=/home/streettracker/streettracker/output

; Resource hygiene — stops one runaway process from OOM'ing the device.
; Orin Nano Super has 8 GB RAM; leave headroom for the kernel + dashboard.
MemoryMax=6G

[Install]
WantedBy=multi-user.target
