*.engine
*.onnx
*.pt
# DR exceptions: the small live inference models travel with the code so a
# fresh checkout can run inference. The 164 MB make model is too big for a
# public repo -- it lives as a GitHub Release asset (see the tracked
# makemodel_b0.meta.json sidecar for which release/model is in production).
!src/streettracker/analysis/makemodel/models/bodytype_b0.pt
!src/streettracker/analysis/alpr/models/license_plate_detector.pt
*.weights
output/
# make/model CNN training runs (checkpoints, history.json, logs)
runs/
# Production-model sidecars are now TRACKED -- they record each promoted
# model's arch / input_size / training-corpus fingerprint (incl. the
# Release-hosted make model). Control-panel runtime state stays ignored.
control_jobs.json
control_playbooks.json
camera_config.json
# StreetTracker convention: configs/camera.json carries the live Reolink
# password and is per-install. configs/camera.example.json IS tracked.
configs/camera.json
# DVSA MOT history API credentials (X-API-Key + OAuth client_id/secret).
# configs/dvsa.example.json IS tracked as the schema reference.
configs/dvsa.json
# Showcase speed calibration (px/s -> mph), per-install camera geometry.
# configs/showcase.example.json IS tracked as the schema reference.
configs/showcase.json
# Door zone for door-origin ("my walks") detection -- an operator-traced
# polygon locating the front door in frame (per-install, points at the
# operator's home). configs/door_zone.example.json IS tracked as the schema.
configs/door_zone.json
*.mp4
*.mkv

# Editor noise
.vscode/
.idea/
*.swp
.DS_Store

# Claude Code workspace: mostly per-install scratch + sample-snap bundles
# (stay ignored). DR exceptions are TRACKED: the analysis/measurement
# scripts and the operator-traced scene geometry (polygon / triggers /
# ghost-mask / sketch) -- irreplaceable without physical access to the
# camera. The two camera-ISP helpers are re-ignored (they hardcode the LAN
# IP + admin account). NOTE: uses `.claude/*` not `.claude/` so git still
# descends the dir to honour these negations.
.claude/*
!.claude/*.py
.claude/setexp.py
.claude/setexp_auto.py
!.claude/ghost_mask.json
!.claude/snap_gate.json
!.claude/triggers_proposal.json
!.claude/road_polygon_user.json
!.claude/road_zones.json
!.claude/road_polygon.json
!.claude/reolink_isp_current.json
!.claude/sketch_me_done.png

# ----------------------------------------------------------------------
# BIOMETRIC DATA -- NEVER COMMIT, NEVER RELEASE.
#
# Per-person identity (analysis/identity.py) produces face embeddings and
# named-person verdicts for the household and enrolled regulars. This
# repo is PUBLIC and the disaster-recovery flow deliberately pushes small
# models, geometry JSON and scripts to it -- none of the below may ever
# ride along, including into a GitHub release. Under UK GDPR this is
# special-category data and it covers visitors, not just the operator.
#
# Deliberately broad and placed AFTER the .claude negations above so a
# stray identity artefact can't be re-included by an earlier rule.
configs/identities/
*_identity.json
*.embeddings.json
faces/
